# Copy this file to ".env" in the same folder and fill in real values.

# Required in production — any long random string
JWT_SECRET=change-this-to-a-long-random-string

# Used to build links inside password-reset emails
FRONTEND_URL=http://localhost:4000

# Optional: leave all of these blank while developing.
# Without them, "forgot password" logs the reset link to the server
# console (and returns it in the API response) instead of emailing it.
#
# Example values for Gmail (use an "app password", not your real password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="EDxKa <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PORT=4000
NODE_ENV=development
